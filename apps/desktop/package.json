{
  "name": "@gungun/desktop",
  "version": "1.0.0",
  "description": "Gungun VPS and proxy manager",
  "author": "Gungun contributors",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node ../../scripts/create-icon.mjs",
    "package:mac": "pnpm run build && electron-builder --mac --arm64 --publish never",
    "package:mac:dir": "pnpm run build && electron-builder --mac dir --arm64 --publish never --config.mac.identity=- --config.mac.notarize=false && pnpm run check:mac:bundle",
    "check:mac:bundle": "node ../../scripts/check-macos-bundle.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0",
    "@gungun/domain": "workspace:*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "acme-client": "^5.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.555.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ssh2": "^1.17.0",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.4",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.1",
    "tailwindcss": "^4.1.17",
    "vite": "^7.2.4"
  },
  "build": {
    "appId": "io.gungun.desktop",
    "productName": "Gungun",
    "directories": {
      "output": "../../release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "../../resources/bin",
        "to": "bin",
        "filter": [
          "fq-linux-amd64",
          "fq-linux-arm64",
          "sing-box-darwin-arm64"
        ]
      },
      {
        "from": "../../resources/THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "../../resources/helpers",
        "to": "helpers"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "target": [
        "dmg"
      ],
      "artifactName": "Gungun-${version}-${arch}.${ext}",
      "icon": "build/icon.png",
      "minimumSystemVersion": "13.0",
      "binaries": [
        "Contents/MacOS/gungun-proxy-helper",
        "Contents/Resources/native/gungun-service-registration.node"
      ]
    },
    "dmg": {
      "title": "Gungun"
    },
    "afterSign": "../../scripts/notarize.cjs",
    "npmRebuild": false,
    "afterPack": "../../scripts/prepare-macos-helper.cjs",
    "beforePack": "../../scripts/check-desktop-build.mjs"
  }
}
