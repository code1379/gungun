{
  "name": "gungun",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.23.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm fq:build && pnpm --filter @gungun/desktop dev",
    "build": "pnpm fq:build && pnpm --filter @gungun/desktop build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "node --import tsx tests/core-integration.ts",
    "test:go": "NODE_USE_ENV_PROXY=1 node scripts/test-go.mjs",
    "fq:build": "NODE_USE_ENV_PROXY=1 node scripts/build-fq.mjs",
    "cores:download": "NODE_USE_ENV_PROXY=1 node scripts/download-cores.mjs",
    "package:mac": "pnpm fq:build && pnpm --filter @gungun/desktop package:mac",
    "test:desktop": "node tests/desktop-smoke.mjs",
    "prepare:dev": "NODE_USE_ENV_PROXY=1 node scripts/prepare-dev.mjs",
    "electron:install": "node scripts/install-electron.mjs",
    "setup:install": "node scripts/install-deps.mjs --frozen-lockfile",
    "test:local-runtime": "vitest run --config vitest.runtime.config.ts",
    "test:macos-proxy": "node scripts/verify-macos-proxy.mjs",
    "test:local-configs": "vitest run --config vitest.core.config.ts",
    "test:macos-helper": "node scripts/check-macos-helper.mjs",
    "package:mac:dir": "pnpm fq:build && pnpm --filter @gungun/desktop package:mac:dir",
    "test:desktop-build": "node scripts/check-desktop-build.mjs"
  },
  "dependencies": {
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "prettier": "^3.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.0.14"
  }
}
