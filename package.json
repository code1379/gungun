{
  "name": "gungun",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @gungun/desktop dev",
    "build": "pnpm --filter @gungun/desktop build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "node --import tsx tests/core-integration.ts",
    "test:go": "cd fq && go test -race ./...",
    "fq:build": "node scripts/build-fq.mjs",
    "cores:download": "node scripts/download-cores.mjs",
    "package:mac": "pnpm --filter @gungun/desktop package:mac",
    "test:desktop": "node tests/desktop-smoke.mjs"
  },
  "dependencies": {
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "prettier": "^3.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.0.14"
  }
}
